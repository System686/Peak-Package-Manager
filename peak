#!/usr/bin/env bash

REPO_URL="https://githubusercontent.com"
CACHE_DIR="/var/cache/peak"
BUILD_DIR="/tmp/peak-build"
DB_DIR="/var/lib/peak/installed"

CONFIG_FILE="/etc/peak.conf"
if [ -f "$CONFIG_FILE" ]; then
    source "$CONFIG_FILE"
fi

export LANG=C
export LC_ALL=C

check_root() {
    if [ "$EUID" -ne 0 ]; then
        echo "[peak] Error: This operation requires root privileges."
        exit 1
    fi
}

show_help() {
    echo "Usage: peak [OPTION] [PACKAGE|PATH]"
    echo ""
    echo "Options:"
    echo "  -S, --sync <pkg>    Download from GitHub, build, and install a package"
    echo "  -B, --build <dir>   Build and install a local PEAKBUILD"
    echo "  -R, --remove <pkg>  Remove an installed package"
    echo "  -h, --help          Show this help message"
}

download_from_github() {
    local pkg="$1"
    local target_dir="${CACHE_DIR}/${pkg}"

    echo "[peak] Connecting to repository for '$pkg'..."
    mkdir -p "$target_dir"

    curl -s -f "${REPO_URL}/${pkg}/PEAKBUILD" -o "${target_dir}/PEAKBUILD"

    if [ $? -ne 0 ]; then
        echo "[peak] Error: Package '$pkg' not found on remote repository!"
        rm -rf "$target_dir"
        exit 1
    fi
}

build_and_install() {
    local target_dir="$1"
    
    if [ ! -f "${target_dir}/PEAKBUILD" ]; then
        echo "[peak] Error: Could not find PEAKBUILD file in ${target_dir}"
        exit 1
    fi

    source "${target_dir}/PEAKBUILD"

    if [ -z "$pkgname" ] || [ -z "$pkgver" ]; then
        echo "[peak] Error: Invalid PEAKBUILD. Missing 'pkgname' or 'pkgver'."
        exit 1
    fi

    echo "=========================================="
    echo "  Building:    $pkgname v$pkgver"
    echo "  Description: $pkgdesc"
    echo "=========================================="

    WORK_DIR="${BUILD_DIR}/${pkgname}"
    export pkgdir="${WORK_DIR}/pkg"
    export srcdir="${WORK_DIR}/src"
    
    rm -rf "$WORK_DIR"
    mkdir -p "$srcdir" "$pkgdir"
    cd "$srcdir" || exit 1

    if [ -n "$source" ]; then
        echo "[peak] Downloading sources from: $source"
        curl -L -O "$source"
        
        filename=$(basename "$source")
        if [[ "$filename" =~ \.tar\.gz$|\.tgz$ ]]; then
            tar -xzf "$filename"
        elif [[ "$filename" =~ \.tar\.xz$ ]]; then
            tar -xJf "$filename"
        elif [[ "$filename" =~ \.zip$ ]]; then
            unzip -q "$filename"
        fi
    fi

    echo "[peak] Starting build process..."
    build

    if [ $? -ne 0 ]; then
        echo "[peak] Error during build process for $pkgname!"
        exit 1
    fi

    echo "[peak] Creating installation tree..."
    package

    if [ $? -ne 0 ]; then
        echo "[peak] Error during packaging phase!"
        exit 1
    fi

    check_root
    echo "[peak] Installing files into the system..."
    
    mkdir -p "$DB_DIR"
    
    find "${pkgdir}" -mindepth 1 | sed "s|^${pkgdir}||" > "${DB_DIR}/${pkgname}.files"

    if [ -d "${pkgdir}" ] && [ "$(ls -A "${pkgdir}")" ]; then
        cp -av "${pkgdir}"/* /
    else
        echo "[peak] Warning: Packaging directory is empty. Nothing to copy."
    fi

    command -v ldconfig &>/dev/null && ldconfig

    echo "=========================================="
    echo "  [✓] $pkgname v$pkgver installed successfully!"
    echo "=========================================="
}

remove_package() {
    local pkg="$1"
    local manifest="${DB_DIR}/${pkg}.files"

    check_root

    if [ ! -f "$manifest" ]; then
        echo "[peak] Error: Package '$pkg' is not installed or missing manifest."
        exit 1
    fi

    echo "[peak] Removing package '$pkg'..."
    
    local file_list=()
    while IFS= read -r line; do
        file_list+=("$line")
    fi < "$manifest"

    for ((i=${#file_list[@]}-1; i>=0; i--)); do
        local target="${file_list[$i]}"
        if [ -f "$target" ] || [ -L "$target" ]; then
            rm -f "$target"
        elif [ -d "$target" ]; then
            rmdir "$target" 2>/dev/null
        fi
    done

    rm -f "$manifest"

    command -v ldconfig &>/dev/null && ldconfig

    echo "[peak] Package '$pkg' removed successfully!"
}

case "$1" in
    -S|--sync)
        if [ -z "$2" ]; then
            echo "[peak] Error: Please specify a package name (e.g., peak -S grub)"
            exit 1
        fi
        download_from_github "$2"
        build_and_install "${CACHE_DIR}/$2"
        ;;
    -B|--build)
        DIR="${2:-.}"
        build_and_install "$DIR"
        ;;
    -R|--remove)
        if [ -z "$2" ]; then
            echo "[peak] Error: Please specify a package name to remove"
            exit 1
        fi
        remove_package "$2"
        ;;
    -h|--help|*)
        show_help
        ;;
esac
