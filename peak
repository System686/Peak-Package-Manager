#!/usr/bin/env bash

REPO_URL="https://github.com/System686/K2-linux/tree/k2-user-repository"
CACHE_DIR="/var/cache/peak"
BUILD_DIR="/tmp/peak-build"

check_root() {
    if [ "$EUID" -ne 0 ]; then
        echo "[peak] Error: This operation requires root privileges."
        exit 1
    fi
}

show_help() {
    echo "Usage: peak [OPTION] [PACKAGE|PATH]"
    echo ""
    echo "Options:"
    echo "  -S, --sync <pkg>    Download from GitHub, build and install a package"
    echo "  -B, --build <dir>   Build and install a local PEAKBUILD"
    echo "  -h, --help          Show this help message"
}

build_and_install() {
    local target_dir="$1"
    
    if [ ! -f "${target_dir}/PEAKBUILD" ]; then
        echo "[peak] Error: Could not find PEAKBUILD file in ${target_dir}"
        exit 1
    fi

    source "${target_dir}/PEAKBUILD"

    echo "=========================================="
    echo "  Building:    $pkgname v$pkgver"
    echo "  Description: $pkgdesc"
    echo "=========================================="

    WORK_DIR="${BUILD_DIR}/${pkgname}"
    PKGDIR="${WORK_DIR}/pkg"
    
    rm -rf "$WORK_DIR"
    mkdir -p "$WORK_DIR" "$PKGDIR"
    cd "$WORK_DIR" || exit 1

    if [ -n "$source" ]; then
        echo "[peak] Downloading sources from: $source"
        curl -L -O "$source"
        
        filename=$(basename "$source")
        if [[ "$filename" =~ \.tar\.gz$|\.tgz$ ]]; then
            tar -xzf "$filename"
        elif [[ "$filename" =~ \.tar\.xz$ ]]; then
            tar -xJf "$filename"
        elif [[ "$filename" =~ \.zip$ ]]; then
            unzip -q "$filename"
        fi
    fi

    echo "[peak] Starting build process..."
    build

    if [ $? -ne 0 ]; then
        echo "[peak] Error during build process for $pkgname!"
        exit 1
    fi

    echo "[peak] Creating installation tree..."
    package

    if [ $? -ne 0 ]; then
        echo "[peak] Error during packaging phase!"
        exit 1
    fi

    check_root
    echo "[peak] Installing files into the system..."
    cp -av "${PKGDIR}"/* /

    command -v ldconfig &>/dev/null && ldconfig

    echo "=========================================="
    echo "  [✓] $pkgname v$pkgver installed successfully!"
    echo "=========================================="
}

download_from_github() {
    local pkg="$1"
    local target_dir="${CACHE_DIR}/${pkg}"

    echo "[peak] Connecting to repository for '$pkg'..."
    mkdir -p "$target_dir"

    curl -s -f "${REPO_URL}/${pkg}/PEAKBUILD" -o "${target_dir}/PEAKBUILD"

    if [ $? -ne 0 ]; then
        echo "[peak] Error: Package '$pkg' not found on remote repository!"
        rm -rf "$target_dir"
        exit 1
    fi
}

case "$1" in
    -S|--sync)
        if [ -z "$2" ]; then
            echo "[peak] Error: Please specify a package name (e.g., peak -S grub)"
            exit 1
        fi
        download_from_github "$2"
        build_and_install "${CACHE_DIR}/$2"
        ;;
    -B|--build)
        DIR="${2:-.}"
        build_and_install "$DIR"
        ;;
    -h|--help|*)
        show_help
        ;;
esac
